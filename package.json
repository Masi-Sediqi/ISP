{
  "name": "isp-smart",
  "private": true,
  "version": "1.0.0",
  "productName": "Afghan Power",
  "description": "Afghan Power web application.",
  "author": "AFGHAN POWER",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "desktop": "node scripts/dev.cjs",
    "server": "node transport-backend/server.js",
    "web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder --win squirrel",
    "preview": "vite preview",
    "lint": "eslint .",
    "start:lan": "node scripts/start-lan.cjs",
    "postgres:prepare": "node transport-backend/scripts/prepare-postgres.js",
    "postgres:migrate": "node transport-backend/scripts/migrate-json-to-postgres.js"
  },
  "build": {
    "appId": "com.afghanpower.ispsmart",
    "productName": "Afghan Power",
    "artifactName": "Afghan Power Setup ${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "compression": "store",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "transport-backend/**/*",
      "!transport-backend/node_modules/**/*",
      "!transport-backend/package-lock.json",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "squirrel"
      ],
      "icon": "build/icon.ico",
      "executableName": "Afghan Power",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "es-toolkit": "1.50.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "7.3.6",
    "wait-on": "^9.1.0"
  }
}
