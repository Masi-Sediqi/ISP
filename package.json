{
  "name": "transport-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c green,cyan \"node transport-backend/server.js\" \"vite\"",
    "dev:web": "vite",
    "electron-dev": "concurrently -k -n SERVER,WEB,ELECTRON -c green,cyan,magenta \"node transport-backend/server.js\" \"vite\" \"wait-on http://localhost:5173 http://127.0.0.1:5000/api/accounts && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.larmoond.transport",
    "productName": "Transport Management System",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "dist/**/*",
      "electron/**/*",
      "transport-backend/**/*",
      "!transport-backend/node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سیستم مدیریت حمل و نقل"
    }
  }
}
