{
  "name": "afghan-power",
  "private": true,
  "version": "1.0.0",
  "productName": "ISP",
  "description": "ISP asset and inventory management desktop application.",
  "author": "AFGHAN POWER",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c green,cyan \"node transport-backend/server.js\" \"vite\"",
    "dev:web": "concurrently -k -n SERVER,WEB -c green,cyan \"node transport-backend/server.js\" \"vite\"",
    "dev:electron": "concurrently -k -n WEB,ELECTRON -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "npm run build:web && node ./node_modules/electron-builder/cli.js --dir",
    "dist": "npm run build:web && node ./node_modules/electron-builder/cli.js --win --x64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.3",
    "electron": "42.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.afghanpower.isp",
    "productName": "ISP",
    "electronVersion": "42.3.3",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "artifactName": "ISP-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "dist/**/*",
      "electron/**/*",
      "transport-backend/**/*",
      "!transport-backend/node_modules/**/*",
      "!**/*.map",
      "!**/.env",
      "!**/.env.*",
      "!**/screenshots/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ISP"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ISP",
      "uninstallDisplayName": "ISP",
      "deleteAppDataOnUninstall": false
    }
  }
}
