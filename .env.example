# VPS / local API configuration
# Keep /api when Nginx proxies the application to the backend on port 5050.
VITE_API_ROOT=/api

# Backend process configuration (set these in transport-backend/.env on the VPS)
PORT=5050
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=afghanpower
PGUSER=afghanpower
PGPASSWORD=CHANGE_ME
